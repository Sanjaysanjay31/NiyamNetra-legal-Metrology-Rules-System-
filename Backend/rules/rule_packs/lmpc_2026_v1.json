  "rules": [
    {
      "rule_id": "RULE_LMPC_01_MANDATORY_DECLARATIONS",
      "code": "CHK01",
      "rule_pack_version": "2026.07.v1",
      "title": "Mandatory declarations on retail pre-packaged commodity under Rule 6(1)",
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_rule": "Rule 6(1)",
      "amendment_reference": "GSR 629(E) dated 23.06.2017 w.e.f 01.01.2018",
      "effective_from": "2011-03-07",
      "effective_to": null,
      "severity": "critical",
      "statutory_limb": "36(1)",
      "ledger_ref": "L-03",
      "applicability": {
        "inspection_sources": ["physical_package"],
        "target_commodities": ["all"],
        "excluded_commodities": [],
        "transaction_types": ["retail"],
        "is_imported": null,
        "is_perishable": null,
        "is_medical_device": null,
        "has_sticker": null,
        "max_weight_kg": 25.0,
        "max_volume_l": 25.0,
        "notes": "Applies to all retail packages within Chapter II scope"
      },
      "required_evidence": ["ocr_evidence"],
      "required_fields": [
        "commodity_name",
        "manufacturer",
        "net_quantity",
        "mrp",
        "date_of_manufacture",
        "consumer_care"
      ],
      "evaluation_method": {
        "method": "presence",
        "parameters": {
          "required_declarations": [
            "commodity_name",
            "manufacturer",
            "net_quantity",
            "mrp",
            "date_of_manufacture",
            "consumer_care"
          ]
        }
      },
      "remediation": "Ensure every pre-packaged retail commodity visibly displays the name/address of manufacturer or packer, commodity name, net quantity, month/year of manufacture or packing, retail sale price (MRP), and consumer care contact details.",
      "enabled": true
    },
    {
      "rule_id": "RULE_LMPC_02_TOBACCO_CARVEOUT",
      "code": "CHK02",
      "rule_pack_version": "2026.07.v1",
      "title": "Exemption carve-out for tobacco and tobacco products under Rule 26(a)",
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_rule": "Rule 26(a)",
      "amendment_reference": null,
      "effective_from": "2011-03-07",
      "effective_to": null,
      "severity": "advisory",
      "statutory_limb": null,
      "ledger_ref": "L-15",
      "applicability": {
        "inspection_sources": ["physical_package"],
        "target_commodities": ["tobacco", "cigarettes", "cigars", "beedis", "gutkha"],
        "excluded_commodities": [],
        "transaction_types": ["retail"],
        "is_imported": null,
        "is_perishable": null,
        "is_medical_device": null,
        "has_sticker": null,
        "max_weight_kg": null,
        "max_volume_l": null,
        "notes": "Rule 26(a) carves out packages of bidi and cigarettes from certain LMPC labelling requirements"
      },
      "required_evidence": ["operator_declaration"],
      "required_fields": ["is_tobacco"],
      "evaluation_method": {
