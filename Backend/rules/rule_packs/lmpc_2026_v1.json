    {
      "rule_id": "RULE_LMPC_03_CHAPTER_II_APPLICABILITY",
      "code": "CHK03",
      "rule_pack_version": "2026.07.v1",
      "title": "Chapter II scope and retail quantity thresholds under Rule 3",
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_rule": "Rule 3",
      "amendment_reference": null,
      "effective_from": "2011-03-07",
      "effective_to": null,
      "severity": "critical",
      "statutory_limb": null,
      "ledger_ref": null,
      "applicability": {
        "inspection_sources": ["physical_package"],
        "target_commodities": ["all"],
        "excluded_commodities": [],
        "transaction_types": ["wholesale", "institutional", "industrial", "export", "retail"],
        "is_imported": null,
        "is_perishable": null,
        "is_medical_device": null,
        "has_sticker": null,
        "max_weight_kg": null,
        "max_volume_l": null,
        "notes": "Rule 3 establishes thresholds: retail weight > 25 kg / 25 L (or 50 kg for cement/fertiliser/agri) are outside Chapter II"
      },
      "required_evidence": ["operator_declaration", "ocr_evidence"],
      "required_fields": ["transaction_type", "net_quantity_value", "net_quantity_unit"],
      "evaluation_method": {
        "method": "threshold_comparison",
        "parameters": {
          "retail_weight_ceiling_kg": 25.0,
          "retail_volume_ceiling_l": 25.0,
          "agri_ceiling_kg": 50.0,
          "agri_categories": ["cement", "fertiliser", "fertilizer", "agricultural_produce"]
        }
      },
      "remediation": "Packages exceeding 25 kg/L (or 50 kg for agricultural produce/cement/fertiliser) or meant exclusively for institutional/industrial/export buyers are exempt from Chapter II retail packaging provisions.",
      "enabled": true
    },
    {
      "rule_id": "RULE_LMPC_04_MRP_FORM",
      "code": "CHK04",
      "rule_pack_version": "2026.07.v1",
      "title": "Retail sale price correctly expressed under Rule 6(1)(e) read with Rule 2(m)",
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_rule": "Rule 6(1)(e) & Rule 2(m)",
      "amendment_reference": null,
      "effective_from": "2011-03-07",
      "effective_to": null,
      "severity": "major",
      "statutory_limb": "36(1)",
      "ledger_ref": "L-02",
      "applicability": {
        "inspection_sources": ["physical_package"],
        "target_commodities": ["all"],
        "excluded_commodities": [],
        "transaction_types": ["retail"],
        "is_imported": null,
        "is_perishable": null,
        "is_medical_device": null,
        "has_sticker": null,
        "max_weight_kg": 25.0,
        "max_volume_l": 25.0,
        "notes": "MRP must be clearly expressed as Maximum Retail Price inclusive of all taxes"
      },
      "required_evidence": ["ocr_evidence"],
      "required_fields": ["mrp"],
      "evaluation_method": {
        "method": "mrp_expression_check",
        "parameters": {}
      },
      "remediation": "Express retail sale price clearly in Indian Rupees (Rs. or ₹) qualified with 'inclusive of all taxes' or 'incl. of all taxes'.",
      "enabled": true
    },
    {
      "rule_id": "RULE_LMPC_05_NET_QUANTITY_UNITS",
      "code": "CHK05",
      "rule_pack_version": "2026.07.v1",
      "title": "Prescribed standard units of weight, volume, or length without prohibited qualifiers",
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_rule": "Rule 12 & Rule 13",
      "amendment_reference": null,
      "effective_from": "2011-03-07",
      "effective_to": null,
      "severity": "critical",
      "statutory_limb": "36(2)",
      "ledger_ref": "L-01",
      "applicability": {
        "inspection_sources": ["physical_package"],
        "target_commodities": ["all"],
        "excluded_commodities": [],
        "transaction_types": ["retail"],
        "is_imported": null,
        "is_perishable": null,
        "is_medical_device": null,
        "has_sticker": null,
        "max_weight_kg": 25.0,
        "max_volume_l": 25.0,
        "notes": "Applies to all retail net quantity statements"
      },
      "required_evidence": ["ocr_evidence"],
      "required_fields": ["net_quantity"],
      "evaluation_method": {
        "method": "forbidden_words",
        "parameters": {
          "forbidden_catalog_path": "rules/forbidden_words.json",
          "allowed_weight_units": ["g", "kg", "mg", "gm", "gram", "grams", "kilogram", "kilograms"],
          "allowed_volume_units": ["ml", "l", "kl", "litre", "litres", "liter", "liters", "millilitre", "millilitres"],
          "allowed_length_units": ["m", "cm", "mm", "metre", "metres", "meter", "meters"],
          "allowed_count_units": ["u", "n", "number", "numbers", "piece", "pieces", "count"]
        }
      },
      "remediation": "State net quantity in standard metric units (g, kg, ml, l, m) without non-standard units (such as lbs or oz) and without qualifiers like 'approx', 'when packed', or 'minimum'.",
      "enabled": true
    },
    {
      "rule_id": "RULE_LMPC_06_FONT_HEIGHT_PDP",
      "code": "CHK06",
      "rule_pack_version": "2026.07.v1",
      "title": "Minimum height of letters on Principal Display Panel under Rule 7 Table-I",
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_rule": "Rule 7(1) & Table-I",
      "amendment_reference": "GSR 629(E) w.e.f 01.01.2018",
