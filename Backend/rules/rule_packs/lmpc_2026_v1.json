      "applicability": {
        "inspection_sources": ["physical_package"],
        "target_commodities": ["all"],
        "excluded_commodities": [],
        "transaction_types": ["retail"],
        "is_imported": null,
        "is_perishable": null,
        "is_medical_device": null,
        "has_sticker": null,
        "max_weight_kg": 25.0,
        "max_volume_l": 25.0,
        "notes": "Physical font measurement requires defensible scale reference"
      },
      "required_evidence": ["geometry_pdp", "calibration_scale"],
      "required_fields": ["pdp_area_cm2", "mm_per_pixel"],
      "evaluation_method": {
        "method": "table_lookup_height",
        "parameters": {
          "table_i": [
            [50.0, 1.0, 1.5],
