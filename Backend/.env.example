# =============================================================================
#  NiyamNetra backend — environment template
#  Copy this file to  .env  and fill in the REQUIRED value(s) below.
#  .env is gitignored (see .gitignore); never commit real secrets.
# =============================================================================
#
#  >>> WHICH API KEYS DO I NEED TO CONNECT? <<<
#  NONE are required. The backend runs OCR fully on-device by default.
#  There is no OpenAI, Google Cloud Vision, AWS, Azure, Firebase, SMS, email,
#  maps, or payment key to obtain anywhere.
#
#  ONE optional key exists: OCR_SPACE_API_KEY (see the OCR section below). It is
#  only a fallback for deploys that cannot run PaddleOCR/Tesseract (e.g. the slim
#  free-tier Render service). Leave it blank and nothing about local runs changes.
#
#  Everything else runs locally inside your virtualenv (niyamnetra_venv):
#    - OCR            -> PaddleOCR + Tesseract, on-device. PaddleOCR downloads
#                        its recognition model ONCE on first run (a normal pip/
#                        model download, NOT an API key), then works offline.
#    - Barcodes       -> pyzbar / OpenCV, on-device.
#    - Image + PDF/DOCX/QR -> Pillow / OpenCV / ReportLab / python-docx /
#                        qrcode, all local.
#    - Panel detection-> YOLOv8 weights (ultralytics), local.
#  The ONLY outbound network call in the whole app is listing_fetcher.py, which
#  does an UNAUTHENTICATED https GET of a public e-commerce product page for the
#  online-declaration check (Rule 6). It is SSRF-guarded and needs no key.
#
#  So the only values YOU must set are:
#    1. JWT_SECRET   (REQUIRED — no default; app refuses to start without it)
#    2. DATABASE_URL (REQUIRED for this project — your Supabase/PostgreSQL URL)
#    3. TESSERACT_CMD (only on Windows / non-standard tesseract install)
#  Everything else below has a safe default in config.py and can stay unset.
# =============================================================================


# --- app -----------------------------------------------------------------
ENV=dev                                 # dev | prod  (prod turns on HSTS)
APP_NAME=NiyamNetra
PUBLIC_BASE_URL=http://localhost:8000   # used when building QR / links

# --- database: Supabase (PostgreSQL) — REQUIRED --------------------------
# This project runs entirely on Supabase/PostgreSQL. SQLite is not used.
# Driver MUST be  postgresql+psycopg://  (psycopg 3, per requirements.txt);
# a bare postgresql:// URL makes SQLAlchemy look for the uninstalled psycopg2.
#
# Recommended: Supabase SESSION POOLER (port 5432) — IPv4-friendly and
# supports prepared statements, so the app AND alembic migrations work.
# Copy the exact string from Supabase -> Project -> Connect.
#   DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection (IPv6-only unless IPv4 add-on):
#   DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# Avoid the TRANSACTION pooler (port 6543): it breaks psycopg3 prepared
# statements and Alembic DDL.
DATABASE_URL=

# --- auth (REQUIRED) -----------------------------------------------------
# The ONLY mandatory secret. Not an external key — a random string YOU mint.
# Must be >= 32 chars and not a known-weak placeholder, or the app won't boot.
#   Generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Optional auth tuning (defaults shown):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_HOURS=12
# REFRESH_TOKEN_DAYS=30
# REFRESH_COOKIE_NAME=nn_refresh

# --- CORS ----------------------------------------------------------------
# A REGEX (not a glob). Default in config.py allows localhost:5173/8081,
# 127.0.0.1, LAN 192.168.x.x, and Expo (exp://). Override only if needed:
# CORS_ORIGIN_REGEX=^(https?://localhost:(5173|8081)|exp://.*)$

# --- evidence & limits (defaults in config.py) ---------------------------
# EVIDENCE_DIR / OUT_DIR default under the Backend folder and are auto-created.
# MAX_UPLOAD_MB=25
# MAX_IMAGE_PIXELS=80000000            # decompression-bomb ceiling
# MIN_PANEL_PIXEL_HEIGHT=400
# EVIDENCE_MIN_FREE_GB=5.0             # below this, new inspections are refused

# --- capacity (defaults in config.py) ------------------------------------
# ASSESS_CONCURRENCY=0                 # 0 -> os.cpu_count()
# ASSESS_QUEUE_WAIT_S=20
# RATE_LIMIT_LOGIN_PER_MIN=5
# RATE_LIMIT_API_PER_MIN=300
# DASHBOARD_CACHE_TTL_SECONDS=60

# --- OCR (all optional) --------------------------------------------------
# OCR_LANGS=en,hi
# OCR_MIN_CONFIDENCE=0.60
# On Windows, point at the tesseract binary (e.g. UB-Mannheim build):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# Cloud OCR fallback (OCR.space) — used ONLY when PaddleOCR and Tesseract are
# both unavailable, so a no-OCR deploy (slim Render) still reads labels instead
# of returning not_assessed. Get a free key (no card) at ocr.space/ocrapi/freekey.
# Sends the label image to a third party — fine for demos, weigh for real data.
# OCR_SPACE_API_KEY=          # blank = disabled (default)
# OCR_SPACE_ENGINE=1          # 1 = word boxes + non-Latin; 2 = Latin-only, no boxes
# OCR_SPACE_LANGUAGE=eng      # OCR.space code, e.g. eng or hin
# OCR_SPACE_TIMEOUT_S=25

# --- rules (defaults in config.py; change only with a new catalog) -------
# RULES_AS_AT=2026-07-01
# ENGINE_VERSION=2.0.0

# --- seeding (shell var for seed.py ONLY; deliberately NOT a Settings field)
# Read from the environment by seed.py, never by the running app.
#   export SEED_PASSWORD=...    (bash)     before running the seed step
#   $env:SEED_PASSWORD="..."    (PowerShell)
