# NiyamNetra portal environment template. Copy to .env.
# There are no API keys in this portal: it talks only to the NiyamNetra backend,
# and the backend itself uses no third-party keys.

# Base URL of the NiyamNetra backend.
# This file is the LOCAL target. Do not edit it to point at Render — instead run
#   npm run dev:render     (or  npm run build:render )
# which loads .env.render and overrides this value. That way switching backends
# never touches a URL by hand.
VITE_API_URL=http://localhost:8000

# true  - fall back to fixture data when the backend is unreachable, with a
#         visible "Demo data" chip on every screen that does so.
# false - show the real error state instead. Use this for verification runs;
#         mocks return the shape you expected, the backend returns the shape it has.
VITE_DEMO_DATA=true
