# NiyamNetra portal — RENDER target.
# Loaded only by `npm run dev:render` / `npm run build:render` (vite --mode render).
# Values here override .env, so .env stays the local-development file and you
# never edit a URL to switch backends.
#
# FILL THIS IN ONCE — no trailing slash. It is the only place the portal's
# Render URL is written.
VITE_API_URL=https://niyamnetra-backend.onrender.com

# Against a real backend, show real error states rather than fixture data.
VITE_DEMO_DATA=false
