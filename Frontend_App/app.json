{
  "expo": {
    "name": "NiyamNetra",
    "slug": "niyamnetra-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0F2A44",
      "resizeMode": "contain"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.niyamnetra.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2A44"
      },
      "package": "com.niyamnetra.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      // LAN dev over http:// needs cleartext allowed on Android. This flag only
      // permits http — https (Render prod) always works either way. Expo Go on
      // a phone + Metro on a laptop is http://<lan-ip>:8081/8000, so false
      // breaks LAN testing with a white "cannot reach backend" error. Keep
      // true; prod is unaffected (it uses https URLs).
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NiyamNetra to access your camera to capture package photos for assessment."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow NiyamNetra to use your location for inspection geotagging."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow NiyamNetra to use Face ID for secure authentication."
        }
      ]
    ]
  }
}
